APP_ENV=development
APP_PORT=8081

POSTGRES_DB=staynest
POSTGRES_USER=staynest
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Connection from your local machine
DATABASE_URL=postgres://staynest:change_me_to_a_strong_password@localhost:5437/staynest?sslmode=disable

# Connection from the API container
DATABASE_URL_DOCKER=postgres://staynest:change_me_to_a_strong_password@postgres:5432/staynest?sslmode=disable

JWT_SECRET=replace_with_a_generated_secret

# Razorpay test credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
